# ============================================================
# نمونه تنظیمات محیطی — دفتر خدمات سلامت ۴۷۷
# این فایل را به .env کپی کنید و در صورت نیاز مقادیر را تنظیم کنید.
# هیچ متغیر اجباری وجود ندارد؛ سایت و سامانه بدون هیچ‌کدام کار می‌کند.
# ============================================================

# --- نشانی عمومی سایت (بدون / انتهایی) ---
# برای تولید canonical، sitemap.xml و آدرس‌های Open Graph استفاده می‌شود.
# خالی بماند، مقدار پیش‌فرض https://khadamat447.ir در نظر گرفته می‌شود.
NEXT_PUBLIC_SITE_URL=

# --- حالت خروجی استاتیک (GitHub Pages) ---
# true = خروجی HTML استاتیک با basePath=/Khadamat447
# در Vercel و اجرای محلی، این متغیر را تنظیم نکنید.
STATIC_EXPORT=false
