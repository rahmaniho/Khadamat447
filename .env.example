# ============================================================
# نمونه تنظیمات محیطی - دفتر خدمات سلامت ۴۷۷
# این فایل را به .env کپی کنید و مقادیر واقعی را جایگزین کنید.
# هرگز فایل .env واقعی را در Git یا مرورگر قرار ندهید.
# مقادیر زیر نمونه هستند و هیچ‌کدام ایمیل یا کلید واقعی نیستند.
# ============================================================

# --- پایگاه داده ---
# خالی یا sqlite:./.data/khadamat447.db  -> SQLite (پیش‌فرض، مناسب یک سرور)
# postgres://USER:PASS@HOST:5432/DBNAME  -> PostgreSQL (برای محیط عملیاتی؛ docs/DEPLOY.md)
DATABASE_URL=
PG_SSL=false
PG_POOL_MAX=8

# --- نشانی عمومی سایت (بدون / انتهایی). پس از تعیین دامنه واقعی تنظیم کنید ---
NEXT_PUBLIC_SITE_URL=

# --- ورود مدیر اولیه (فقط هنگام ساخت اولین کاربر؛ پس از آن حذف کنید) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- کلید امضای نشست‌ها (حداقل ۳۲ نویسه تصادفی). مثال تولید: openssl rand -hex 32 ---
SESSION_SECRET=
SESSION_DAYS=7

# --- محل ذخیره مدارک خصوصی (خارج از پوشه public) ---
STORAGE_DIR=

# --- اعلان‌های ایمیلی ---
# خالی بماند = ایمیل رسمی دفتر (Info@Khadamat447.IR) استفاده می‌شود؛ برای تغییر، مقدار جدید را وارد کنید.
ADMIN_NOTIFICATION_EMAIL=
# فرستنده ایمیل‌ها (باید در ارائه‌دهنده ایمیل احراز شده باشد)
MAIL_FROM=
# گزینه ۱: Resend
RESEND_API_KEY=
# گزینه ۲: SMTP سازمانی یا سرویس تراکنشی دارای SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TLS_INSECURE=false

# --- ایمیل عمومی برای نمایش در سایت (خالی بماند = Info@Khadamat447.IR) ---
PUBLIC_CONTACT_EMAIL=

# --- اعلان تلگرام (اختیاری؛ بدون اطلاعات حساس) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- رفتار لاگ‌ها ---
# false یعنی فقط کنسول؛ پیش‌فرض: فایل .data/logs/app.log
LOG_TO_FILE=true

# --- کلید هش IP در پایگاه داده (اختیاری؛ اگر خالی باشد از SESSION_SECRET استفاده می‌شود) ---
IP_HASH_SALT=
